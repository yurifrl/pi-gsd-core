{
  "name": "pi-gsd-core",
  "version": "0.1.2",
  "description": "GSD (Get Shit Done) for pi and Oh My Pi — vendored skills and agents synced from @opengsd/gsd-core, one dual-host extension, self-maintaining runtime wiring",
  "license": "MIT",
  "author": "yurifrl",
  "type": "module",
  "keywords": [
    "pi-package",
    "omp",
    "oh-my-pi",
    "gsd",
    "get-shit-done",
    "spec-driven-development",
    "skills",
    "agents"
  ],
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "vendor/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yurifrl/pi-gsd-core.git"
  },
  "homepage": "https://github.com/yurifrl/pi-gsd-core#readme",
  "bugs": {
    "url": "https://github.com/yurifrl/pi-gsd-core/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/gsd-core.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/gsd-core.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "update": "node scripts/sync-gsd-core.mjs --commit --tag",
    "update:check": "node scripts/sync-gsd-core.mjs --dry-run",
    "test": "node --test",
    "lint": "node --check scripts/sync-gsd-core.mjs && node --check scripts/lib/project.mjs && node --check scripts/lib/upstream.mjs && node --check scripts/lib/versioning.mjs"
  },
  "dependencies": {
    "@opengsd/gsd-core": "^1.13.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
